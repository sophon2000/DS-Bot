{
  "name": "ds-bot",
  "version": "0.2.3-vh.5",
  "description": "DS Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/sophon2000/DS-Bot#readme",
  "bugs": {
    "url": "https://github.com/sophon2000/DS-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophon2000/DS-Bot.git",
    "directory": "ds-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json",
    "./host-package": "./scripts/host-package.mjs"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "client.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "host-package.json",
    "scripts/host-package.mjs",
    "HOST-INTEGRATION.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh",
    "pack:host": "node scripts/host-package.mjs prepare"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2.vh.2.local.20261031.1",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2.vh.2.local.20261031.1",
    "@deepseek-ai/dsh-web": "0.2.2-alpha.2.vh.2.local.20261031.1"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tar": "7.5.22"
  }
}
